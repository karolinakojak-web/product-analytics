# Looker API credentials for `python3 prepare_data.py --fetch`.
#
# Generate a client ID / secret from your Looker profile:
#   https://bi.lumapps.com/account  ->  API Keys
#
# Either export these in your shell, or copy this file to .env and source it:
#   cp .env.example .env && set -a && source .env && set +a
#
# Mind the host: no trailing slash before the port.
LOOKERSDK_BASE_URL="https://bi.lumapps.com:19999"
LOOKERSDK_CLIENT_ID="your_client_id"
LOOKERSDK_CLIENT_SECRET="your_client_secret"
